# ============================================================
#  BIẾN MÔI TRƯỜNG CLUSTER — Sao chép thành .env rồi điền vào
#  KHÔNG commit file .env lên git (đã thêm vào .gitignore)
#
#  Cách lấy Tailscale IP:
#    macOS / WSL2: tailscale ip -4
#    Windows PowerShell: tailscale ip -4
#  IP Tailscale luôn có dạng 100.x.x.x
# ============================================================

# ─────────────────────────────────────────────────────────────
#  MASTER MACHINE — điền trên TẤT CẢ các máy
#  (cả master lẫn worker đều cần biết IP của master)
# ─────────────────────────────────────────────────────────────
MASTER_TS_IP=100.x.x.x
MASTER_TS_HOSTNAME=master-pc

# ─────────────────────────────────────────────────────────────
#  WORKER MACHINES — điền IP Tailscale của từng worker
#  (dùng để master machine resolve hostname datanode1/datanode2)
#  Bỏ trống nếu không có worker đó
# ─────────────────────────────────────────────────────────────
WORKER1_TS_IP=100.x.x.x
WORKER2_TS_IP=100.x.x.x

# ─────────────────────────────────────────────────────────────
#  WORKER ID — chỉ đặt trên máy worker
#  Máy worker-1: WORKER_ID=1
#  Máy worker-2: WORKER_ID=2
# ─────────────────────────────────────────────────────────────
WORKER_ID=1
# Port Web UI của Spark Worker trên host machine
# worker-1 dùng 8081, worker-2 dùng 8082 (tránh xung đột)
SPARK_WORKER_PORT=8081

# ─────────────────────────────────────────────────────────────
#  TÀI NGUYÊN WORKER — điều chỉnh theo RAM máy thực tế
#  Máy 8GB  RAM: WORKER_MEM=4G,  YARN_MEM_MB=3072
#  Máy 16GB RAM: WORKER_MEM=6G,  YARN_MEM_MB=6144
# ─────────────────────────────────────────────────────────────
WORKER_MEM=4G
WORKER_CORES=2
YARN_MEM_MB=3072

# ─────────────────────────────────────────────────────────────
#  VIRTUAL WORKER — bật khi không có bạn nhóm join máy
#  Tắt mặc định để tránh OOM trên master machine
# ─────────────────────────────────────────────────────────────
ENABLE_VIRTUAL_WORKER=false
VIRTUAL_WORKER_MEM=512m
VIRTUAL_WORKER_CORES=1

# ─────────────────────────────────────────────────────────────
#  HDFS REPLICATION FACTOR
#  1 → chỉ có 1 DataNode (hoặc đang dùng virtual worker)
#  2 → có 2+ DataNode (worker-1 + worker-2 đều đã join)
# ─────────────────────────────────────────────────────────────
DFS_REPLICATION=1

# ─────────────────────────────────────────────────────────────
#  KAFKA CLUSTER ID — giữ nguyên, không cần thay đổi
# ─────────────────────────────────────────────────────────────
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

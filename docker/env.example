# ============================================================
#  BIẾN MÔI TRƯỜNG CLUSTER - Sao chép thành file .env rồi điền thông tin
#  KHÔNG đẩy (commit) file .env lên Git để bảo mật
#
#  Cách lấy địa chỉ IP Tailscale:
#    Chạy lệnh trên Terminal/PowerShell: tailscale ip -4
#  IP Tailscale luôn có định dạng 100.x.x.x
# ============================================================

# --- Cấu hình máy MASTER - Cần điền trên TẤT CẢ các máy (Master và Worker) ---
MASTER_TS_IP=100.x.x.x
MASTER_TS_HOSTNAME=master-pc

# --- Cấu hình các máy WORKER - Điền IP Tailscale của các máy Worker ---
# Để trống nếu không sử dụng máy Worker tương ứng
WORKER1_TS_IP=100.x.x.x
WORKER2_TS_IP=100.x.x.x

# --- Thiết lập mã định danh WORKER ID - Chỉ cấu hình trên các máy Worker ---
# Máy worker-1 điền WORKER_ID=1; Máy worker-2 điền WORKER_ID=2
WORKER_ID=1

# Cổng hiển thị giao diện Web UI của Spark Worker trên máy thực (host)
# worker-1 dùng cổng 8081, worker-2 dùng cổng 8082
SPARK_WORKER_PORT=8081

# Địa chỉ IP Tailscale của chính máy Worker hiện tại (không phải máy Master)
# Sử dụng lệnh 'tailscale ip -4' trên máy Worker để lấy địa chỉ này
WORKER_TS_IP=100.x.x.x

# --- Cấu hình tài nguyên cấp phát cho Worker - Điều chỉnh theo RAM của máy thực tế ---
# Ví dụ cấu hình đề xuất:
#   - Máy RAM 8GB:  WORKER_MEM=4G, YARN_MEM_MB=3072
#   - Máy RAM 16GB: WORKER_MEM=6G, YARN_MEM_MB=6144
WORKER_MEM=4G
WORKER_CORES=2
YARN_MEM_MB=3072

# Bộ nhớ RAM cấp phát cho container Jupyter
JUPYTER_MEM=8g

# --- Chế độ Virtual Worker - Kích hoạt khi chạy thử nghiệm độc lập ---
# Mặc định tắt để tránh quá tải RAM cho máy Master
ENABLE_VIRTUAL_WORKER=false
VIRTUAL_WORKER_MEM=512m
VIRTUAL_WORKER_CORES=1

# --- Hệ số nhân bản dữ liệu (HDFS Replication Factor) ---
#  Điền 1 nếu chỉ có 1 DataNode hoạt động (hoặc chế độ Virtual Worker)
#  Điền 2 nếu có từ 2 DataNode hoạt động trở lên
#  Lưu ý: Sau khi thay đổi giá trị này, cần tiến hành build lại các Docker image
DFS_REPLICATION=2


<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!--
  yarn-site.xml - File cấu hình cho YARN ResourceManager và NodeManager
  Mô hình nhiều máy:
    - ResourceManager chạy trên máy master (hostname "namenode")
    - NodeManager chạy trên các máy worker
    - Các worker phân giải "namenode" thành MASTER_TS_IP qua extra_hosts
-->
<configuration>

  <property>
    <name>yarn.nodemanager.aux-services</name>
    <value>mapreduce_shuffle</value>
  </property>

  <property>
    <name>yarn.nodemanager.aux-services.mapreduce.shuffle.class</name>
    <value>org.apache.hadoop.mapred.ShuffleHandler</value>
  </property>

  <property>
    <name>yarn.resourcemanager.hostname</name>
    <value>namenode</value>
  </property>

  <property>
    <name>yarn.resourcemanager.address</name>
    <value>namenode:8032</value>
  </property>

  <property>
    <name>yarn.resourcemanager.scheduler.address</name>
    <value>namenode:8030</value>
  </property>

  <property>
    <name>yarn.resourcemanager.admin.address</name>
    <value>namenode:8033</value>
  </property>

  <property>
    <!-- Cổng 8031: Resource Tracker - NodeManager đăng ký tài nguyên với ResourceManager.
         Cần mở cổng 8031 để các máy worker bên ngoài có thể kết nối. -->
    <name>yarn.resourcemanager.resource-tracker.address</name>
    <value>namenode:8031</value>
  </property>

  <property>
    <name>yarn.resourcemanager.webapp.address</name>
    <value>0.0.0.0:8088</value>
  </property>

  <property>
    <name>yarn.nodemanager.resource.memory-mb</name>
    <value>3072</value>
    <description>
      Bộ nhớ RAM cho YARN NodeManager. Mặc định là 3072MB (phù hợp máy 8GB).
      Tăng lên 6144MB nếu máy worker có 16GB RAM.
    </description>
  </property>

  <property>
    <name>yarn.scheduler.maximum-allocation-mb</name>
    <value>3072</value>
  </property>

  <property>
    <name>yarn.scheduler.minimum-allocation-mb</name>
    <value>256</value>
  </property>

  <property>
    <name>yarn.nodemanager.resource.cpu-vcores</name>
    <value>2</value>
  </property>

  <property>
    <name>yarn.nodemanager.webapp.address</name>
    <value>0.0.0.0:8042</value>
  </property>

  <property>
    <name>yarn.nodemanager.vmem-check-enabled</name>
    <value>false</value>
  </property>

  <property>
    <name>yarn.nodemanager.pmem-check-enabled</name>
    <value>false</value>
  </property>

  <property>
    <name>yarn.log-aggregation-enable</name>
    <value>true</value>
  </property>

  <property>
    <name>yarn.resourcemanager.nm.liveness-monitor.interval-ms</name>
    <value>3000</value>
    <description>ResourceManager kiểm tra trạng thái hoạt động (liveness) của NodeManager mỗi 3 giây (mặc định là 1 giây).</description>
  </property>

  <property>
    <name>yarn.nm.liveness-monitor.expiry-interval-ms</name>
    <value>120000</value>
    <description>Thời gian chờ 120 giây trước khi ResourceManager coi NodeManager là đã mất kết nối.</description>
  </property>

  <property>
    <name>yarn.resourcemanager.connect.max-wait.ms</name>
    <value>60000</value>
    <description>NodeManager chờ ResourceManager sẵn sàng tối đa 60 giây khi khởi động.</description>
  </property>

  <property>
    <name>yarn.resourcemanager.connect.retry-interval.ms</name>
    <value>5000</value>
    <description>Thử kết nối lại mỗi 5 giây trong khi NodeManager chờ ResourceManager.</description>
  </property>

</configuration>
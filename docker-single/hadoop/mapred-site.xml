<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!--
  mapred-site.xml — MapReduce configuration
  (Mostly used by YARN; Spark bypasses MapReduce but YARN needs this)
-->
<configuration>

  <!-- Use YARN as the execution framework -->
  <property>
    <name>mapreduce.framework.name</name>
    <value>yarn</value>
  </property>

  <!-- Job History Server -->
  <property>
    <name>mapreduce.jobhistory.address</name>
    <value>namenode:10020</value>
  </property>

  <property>
    <name>mapreduce.jobhistory.webapp.address</name>
    <value>namenode:19888</value>
  </property>

  <!-- ApplicationMaster resource request -->
  <property>
    <name>yarn.app.mapreduce.am.resource.mb</name>
    <value>512</value>
  </property>

  <property>
    <name>yarn.app.mapreduce.am.resource.cpu-vcores</name>
    <value>1</value>
  </property>

  <!-- Map/Reduce task memory -->
  <property>
    <name>mapreduce.map.memory.mb</name>
    <value>512</value>
  </property>

  <property>
    <name>mapreduce.reduce.memory.mb</name>
    <value>512</value>
  </property>

  <!-- Enable uber mode for small jobs (runs in AM, no container overhead) -->
  <property>
    <name>mapreduce.job.ubertask.enable</name>
    <value>true</value>
  </property>

</configuration>
